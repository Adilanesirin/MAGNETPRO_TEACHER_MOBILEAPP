{
  "expo": {
    "name": "MagnetPro Teacher",
    "slug": "magnetpro-teacher",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "magnetproteacher",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6D82"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "To send photos and videos in the class diary",
        "NSMicrophoneUsageDescription": "To record voice notes for parents",
        "NSCameraUsageDescription": "To take photos and videos for the class diary"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A6D82"
      },
      "package": "com.magnetpro.teacher"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c8e625c-8901-40c7-a2c7-39927381118f"
      }
    },
    "owner": "adila-2005"
  }
}

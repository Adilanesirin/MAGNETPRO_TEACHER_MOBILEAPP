{
  "expo": {
    "name": "Edu-Magnet",
    "slug": "magnetpro-teacher",
    "version": "2.2.6",
    "orientation": "portrait",
    "scheme": "magnetproteacher",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/logo-only.png",
    "ios": {
       "buildNumber": "1.1.0",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "To send photos and videos in the class diary",
        "NSMicrophoneUsageDescription": "To record voice notes for parents",
        "NSCameraUsageDescription": "To take photos and videos for the class diary",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.magnetpro.teacher"
    },
    "android": {
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-only.png",
        "backgroundColor": "#1A6D82"
      },
      "package": "com.magnetpro.teacher"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c8e625c-8901-40c7-a2c7-39927381118f"
      }
    },
    "owner": "adila-2005"
  }
}
